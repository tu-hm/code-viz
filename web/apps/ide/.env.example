# Every variable the IDE reads. pnpm dev loads .env.development (mock API on);
# put overrides in .env.development.local, which git ignores. Copied there
# as is, this file points pnpm dev at the local backend (make dev in backend/).

# API base, used when VITE_USE_MSW=false
VITE_API_BASE_URL=http://localhost:8080/api/v1
# true: answer API calls in the browser with MSW; pick a case with ?scenario=completed|failed-build|busy|slow-tracing
VITE_USE_MSW=false
# comma-separated feature flags; known: visualize
VITE_FLAGS=visualize
