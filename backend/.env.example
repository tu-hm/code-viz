# Dev defaults. make loads this file, then .env if it exists, and exports
# the values to vizd. To override one, copy this file to .env and edit it.
# make parses both files as makefile lines: no quotes, no inline comments.

VIZ_HTTP_ADDR=127.0.0.1:8080
MYSQL_DSN=viz:viz@tcp(127.0.0.1:13306)/viz
VIZ_ENV=dev
VIZ_SANDBOX=docker

# Both roles: language manifests, and object storage for trace chunks. make
# seed creates the bucket and lets CORS_ORIGINS (comma separated) GET chunks
# from it. The AWS SDK reads the region and credentials.
VIZ_ADAPTERS_DIR=adapters
S3_ENDPOINT=http://127.0.0.1:8333
S3_BUCKET=viz-traces
S3_PATH_STYLE=true
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=viz
AWS_SECRET_ACCESS_KEY=viz
CORS_ORIGINS=http://localhost:5173

# The API (--role=api or all). It signs chunk URLs for S3_PUBLIC_ENDPOINT, the
# host browsers fetch chunks from (empty: S3_ENDPOINT), and lets CORS_ORIGINS
# call it. A caller is a keyed hash of its IP: VIZ_IP_HASH_KEY is that key, 32
# bytes or more, and a secret outside dev. POST refuses new jobs while
# VIZ_SLOTS x 10 are queued, VIZ_SLOTS being the worker slots behind the API.
# Share links point at VIZ_WEB_ORIGIN/viz/{id}, the IDE's permalink page.
S3_PUBLIC_ENDPOINT=http://127.0.0.1:8333
VIZ_IP_HASH_KEY=dev-only-ip-hash-key-not-a-secret
VIZ_SLOTS=1
VIZ_WEB_ORIGIN=http://localhost:5173

# The §11 limits are not env settings: each language manifest sets them
# (§10.2), under global ceilings.
