# Dev defaults. make loads this file, then .env if it exists, and exports
# the values to vizd. To override one, copy this file to .env and edit it.
# make parses both files as makefile lines: no quotes, no inline comments.

VIZ_HTTP_ADDR=127.0.0.1:8080
MYSQL_DSN=viz:viz@tcp(127.0.0.1:13306)/viz
VIZ_ENV=dev
VIZ_SANDBOX=docker

# Object storage. make seed creates the bucket; vizd reads these once BE-05 §2 lands.
S3_ENDPOINT=http://127.0.0.1:8333
S3_BUCKET=viz-traces

# Planned settings with their dev defaults. Nothing reads them yet; the task
# in brackets adds each one to vizd's config. Uncomment once it lands.
# VIZ_ADAPTERS_DIR=adapters                     [BE-05 §2]
# S3_PATH_STYLE=true                            [BE-05 §2]
# AWS_REGION=us-east-1                          [BE-05 §2]
# AWS_ACCESS_KEY_ID=viz                         [BE-05 §2]
# AWS_SECRET_ACCESS_KEY=viz                     [BE-05 §2]
# S3_PUBLIC_ENDPOINT=http://127.0.0.1:8333      [BE-06 §3]
# CORS_ORIGINS=http://localhost:5173            [BE-06 §3, §4]

# The §11 limits are not env settings: each language manifest sets them
# (§10.2), under global ceilings.
